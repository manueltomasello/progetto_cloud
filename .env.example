# Credenziali database PostgreSQL (uguali per tutti i microservizi)
DB_USER=gestionale
DB_PASSWORD=gestionale

# Chiave per la firma dei JWT (auth-service) - cambiare in produzione
ENCRYPTION_KEY=chiave-super-segreta-da-cambiare

# --- AI Agent (opzionali: se non impostati il job email resta disattivato) ---
EMAIL_ENABLED=false
OPEN_AI_KEY=
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=993

# --- Kafka gestito (solo per il deploy in cloud / demo ibrida) ---
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
