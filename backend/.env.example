# --------------------------------------------------------------------
# Connessione SQL Server
# --------------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=gestionale_manutenzioni

# Lascia DB_INSTANCE vuoto se usi una porta TCP standard.
# Se invece colleghi a un'istanza nominale (es. SQLEXPRESS) imposta:
#   DB_INSTANCE=SQLEXPRESS
DB_INSTANCE=

# In sviluppo locale (es. SQL Server Express su localhost) tieni
# encrypt=true ma trustServerCertificate=true per accettare il
# certificato self-signed.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# --------------------------------------------------------------------
# Sicurezza applicativa
# --------------------------------------------------------------------
ENCRYPTION_KEY=cambia-questa-chiave-in-produzione

# --------------------------------------------------------------------
# Integrazione e-mail (Agent AI)
# --------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=993

# --------------------------------------------------------------------
# OpenAI
# --------------------------------------------------------------------
OPEN_AI_KEY=

# --------------------------------------------------------------------
# Migrazione dati MariaDB → SQL Server (solo per `npm run migrate:*`)
# --------------------------------------------------------------------
SRC_DB_HOST=localhost
SRC_DB_PORT=3306
SRC_DB_USER=root
SRC_DB_PASSWORD=
SRC_DB_NAME=gestionale_manutenzioni
# Se true lo script svuota le tabelle MSSQL prima di reinserire i dati
WIPE_TARGET=true
